# Replace the placeholders below before publishing — GitHub renders this as the
# repository's "Cite this repository" entry. The title, author names, and url are
# the values most likely to be wrong if left unedited.
cff-version: 1.2.0
message: "If you use this project, please cite it using the metadata below."
title: "Project Name"
type: software
authors:
  - family-names: "Last"
    given-names: "First"
    # orcid: "https://orcid.org/0000-0000-0000-0000"
version: "0.1.0"
# date-released: "YYYY-MM-DD"
url: "https://github.com/uwo-fast/repo-name"
license: GPL-3.0-or-later
# doi: "10.xxxx/xxxxx"
